# ── Database (CeliyoForms — SQLite, MVP) ─────────────────────────────────────
# Absolute path to the CeliyoForms SQLite database file on the host's persistent disk.
# Leave unset for local development/tests: the app falls back to the existing
# in-memory store, which resets on every restart. On the production VPS this must
# point at a path on persistent disk that survives deploys/restarts, e.g.:
#   /srv/apps/celiyoforms/data/celiyoforms.sqlite
# The parent directory must exist and be writable by the app process. Backups are
# handled separately as part of the deployment phase, not by the app itself.
CELIYO_DATABASE_PATH=

# ── CeliyoForms Admin (human/dashboard auth — HTTP Basic Auth via middleware.ts) ─────
# Protects /dashboard, /forms, /responses, /settings/mcp, /settings/storage, and the
# /api/forms/* form-management API. Separate from MCP's per-tenant API keys (never reuse
# admin credentials as an MCP key) and from the legacy Dev Mantra ADMIN_API_USERNAME/
# ADMIN_API_PASSWORD below. This fails closed: if either value is unset, every admin
# request is rejected with 401, it does not disable the check — set both here (or in
# .env.local for local development) before trying to reach /dashboard, /forms, etc.
CELIYO_ADMIN_USERNAME=
CELIYO_ADMIN_PASSWORD=

# ── Database (Neon PostgreSQL — reserved for a later phase, not used by SQLite MVP) ──
CELIYO_DATABASE_URL=postgresql://user:password@host/celiyoforms?sslmode=require

# Legacy Dev Mantra/Fundability database. Do not use this for CeliyoForms tenant data.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/fundability?sslmode=require

# ── AI Provider ──────────────────────────────────────────────────────────────
# Set to "openai" to switch to OpenAI GPT (default: mistral)
AI_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key
OPENAI_API_KEY=sk-...                    # only needed if AI_PROVIDER=openai

# ── Brevo SMTP (email) ───────────────────────────────────────────────────────
# Get these from Brevo → SMTP & API → SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your@email.com           # your Brevo login email
BREVO_SMTP_PASS=your-brevo-smtp-key      # the SMTP key from Brevo dashboard
BREVO_FROM_EMAIL=reports@devmantra.com
BREVO_FROM_NAME=Dev Mantra
BREVO_REPLY_TO=advisory@devmantra.com

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3010
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# ── Admin Dashboard API ───────────────────────────────────────────────────────
ADMIN_API_USERNAME=admin
ADMIN_API_PASSWORD=your-strong-password-here

# S3-compatible storage for form file/video uploads
# Works with AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces, etc.
S3_BUCKET=agentic-form-uploads
S3_REGION=auto
S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
